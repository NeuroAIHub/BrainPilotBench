# data.lock 示例 —— 大数据集 body 永不进 git，按 sha256 内容寻址懒拉取。
# 放在 tasks/<id>/data.lock。run/fetch 时按 uri scheme 拉取、校验 sha256、落本地缓存。
datasets:
  # 任意可直接下载的公共 https：
  - name: atlas-regions
    uri: https://example.org/datasets/atlas/regions.csv
    sha256: 1111111111111111111111111111111111111111111111111111111111111111
    bytes: 1048576
    format: csv
  # 本地文件（开发/测试用）：
  - name: local-fixture
    uri: file:///abs/path/to/fixture.bin
    sha256: 2222222222222222222222222222222222222222222222222222222222222222
    bytes: 1024
  # HuggingFace Hub：hf://[datasets/]<owner>/<repo>[@<revision>]/<path>
  # revision 缺省 "main"；强烈建议 pin 到具体 commit sha(分支可变、sha 不变)。
  # 私有/gated 数据集：export HF_TOKEN=hf_xxx（永不进 git）；
  # 自建镜像：HF_ENDPOINT 覆盖端点。
  - name: gsm8k-train
    uri: hf://datasets/openai/gsm8k@a1b2c3d4/main/train-00000-of-00001.parquet
    sha256: 3333333333333333333333333333333333333333333333333333333333333333
    bytes: 3963202
    format: parquet
