{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "stimulus_ids",
    "neuroids"
  ],
  "properties": {
    "stimulus_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "neuroids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "neuroid_id",
          "subject_id",
          "region"
        ],
        "properties": {
          "neuroid_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "const": "synthetic-language"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
