{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "task_id",
    "task_version",
    "protocol_id",
    "backend",
    "model",
    "input_manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "bpb-alignment-synthetic/1"
    },
    "task_id": {
      "const": "alignment-synthetic"
    },
    "task_version": {
      "const": "0.1"
    },
    "protocol_id": {
      "const": "synthetic-ridge-v1"
    },
    "backend": {
      "const": "synthetic_numpy"
    },
    "model": {
      "const": {
        "id": "synthetic-linear-generator",
        "revision": "1",
        "layer": "fixed.features",
        "tokenizer_revision": "not-applicable",
        "pooling": "not-applicable",
        "context": "generated-independent-vectors",
        "dtype": "float32"
      }
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
