{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "synthetic_only",
    "source",
    "model",
    "axes",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "bpb-alignment-synthetic/1"
    },
    "profile": {
      "const": "synthetic-ridge-v1"
    },
    "synthetic_only": {
      "const": true
    },
    "source": {
      "const": "locally-generated-fixture"
    },
    "model": {
      "const": {
        "id": "synthetic-linear-generator",
        "revision": "1",
        "layer": "fixed.features",
        "tokenizer_revision": "not-applicable",
        "pooling": "not-applicable",
        "context": "generated-independent-vectors",
        "dtype": "float32"
      }
    },
    "axes": {
      "const": {
        "features": [
          "stimulus",
          "feature"
        ],
        "responses": [
          "stimulus",
          "neuroid"
        ]
      }
    },
    "files": {
      "type": "object",
      "required": [
        "stimuli.csv",
        "model/features.npy",
        "model/stimulus_ids.json",
        "brain/responses.npy",
        "brain/coords.json",
        "protocol.json",
        "folds.json",
        "ceiling/ceiling.json",
        "DATA_DICTIONARY.md"
      ],
      "properties": {
        "stimuli.csv": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "model/features.npy": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "model/stimulus_ids.json": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "brain/responses.npy": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "brain/coords.json": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "protocol.json": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "folds.json": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "ceiling/ceiling.json": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "DATA_DICTIONARY.md": {
          "type": "object",
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
